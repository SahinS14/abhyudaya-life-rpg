PORT=3000
JWT_SECRET=replace-this-with-a-long-random-secret-before-deploying
NODE_ENV=development
# Supabase: Connect → Transaction pooler (port 6543), with your database password inserted.
# URL-encode reserved password characters: @ becomes %40, # becomes %23, and ? becomes %3F.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@YOUR_POOLER_HOST:6543/postgres
